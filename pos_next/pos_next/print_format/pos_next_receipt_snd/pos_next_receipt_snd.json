iscount) if doc.price_list_discount else \"-\" }}\r\n                    </td>\r\n                </tr>\r\n            {% endif %}\r\n            \r\n            <tr class=\"bold\">\r\n                <td colspan=\"2\" style=\"background-color: #f2f0f0\">{{ _(\"\u0627\u0644\u0627\u062c\u0645\u0627\u0644\u064a\") }}</td>\r\n                <td class=\"end\" colspan=\"2\">{{ \"{:,.0f}\".format(doc.grand_total) if doc.grand_total else \"-\" }}</td>\r\n            </tr>\r\n            \r\n        </tfoot>\r\n    </table>\r\n    <table dir=\"rtl\" class=\"bordered\">\r\n        <thead style=\"background-color: #f2f0f0\">\r\n            <tr>\r\n                <td class=\"start white-space\" style=\"text-align: right !important\"><strong>{{ _(\"\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639\") }}</strong></td>\r\n                <td class=\"end white-space\" style=\"text-align: left !important\"><strong>{{ _(\"\u0627\u0644\u0645\u0628\u0644\u063a\") }}</strong></td>\r\n            </tr>\r\n        </thead>\r\n        <tbody>\r\n            {% for p in doc.payments %}\r\n            <tr>\r\n                <td class=\"start\" style=\"text-align: right !important\">{{ p.mode_of_payment }}</td>\r\n                <td class=\"end\">\r\n                    <strong>{{ \"{:,.0f}\".format(p.amount) if p.amount else \"-\" }}</strong>\r\n                </td>\r\n            </tr>\r\n            {% endfor %}\r\n            {% if doc.remarks %}\r\n                <tr class=\"bold\">\r\n                    <td style=\"background-color: #f2f0f0\">{{ _(\"\u0627\u0644\u0628\u064a\u0627\u0646\") }}\r\n                        \r\n                    </td>\r\n                    <td class=\"end\" colspan=\"3\">\r\n                        {{ doc.remarks }}\r\n                    </td>\r\n                </tr>\r\n            {% endif %}\r\n        </tbody>\r\n        \r\n    </table>\r\n    \r\n</div>\r\n{% set item_groups = {} %}\r\n\r\n{# \u062a\u062c\u0645\u064a\u0639 \u0627