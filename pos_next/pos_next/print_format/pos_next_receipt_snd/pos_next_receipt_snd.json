ss=\"end\" style=\"padding: 5px 12px;\">\r\n                <b>\r\n                    #{{ doc.name[-5:] | int if doc.name else \"\" }}\r\n                </b>\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"start\" style=\"text-align: right !important; padding: 5px 12px;\">\r\n                <b>\r\n                    \u0646\u0648\u0639 \u0627\u0644\u0637\u0644\u0628\r\n                </b>\r\n            </td>\r\n            <td class=\"end\" style=\"padding: 5px 12px;\">\r\n                {{doc.pos_order_type}}\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"start\" style=\"text-align: right !important; padding: 5px 12px;\">\r\n                <b>\r\n                    \u0627\u0644\u0648\u0642\u062a\r\n                </b>\r\n            </td>\r\n            <td class=\"end\" style=\"padding: 5px 12px;\">\r\n                    {{ frappe.utils.format_time(doc.posting_time, \"hh:mm a\") if doc.posting_time else \"-\" }}\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"start\" style=\"text-align: right !important; padding: 5px 12px;\">\r\n                <b>\r\n                    \u0627\u0644\u062a\u0627\u0631\u064a\u062e\r\n                </b>\r\n            </td>\r\n            <td class=\"end\" style=\"padding: 5px 12px;\">\r\n                    {{ _(frappe.utils.get_datetime(doc.posting_date).strftime(\"%A\")) if doc.posting_date else \"\" }}\r\n                    {{ doc.get_formatted(\"posting_date\") }}\r\n            </td>\r\n        </tr>\r\n        <tr>\r\n            <td class=\"start\" style=\"text-align: right !important; padding: 5px 12px 12px 12px;\">\r\n                <b>\r\n                    \u0627\u0644\u0643\u0627\u0634\u064a\u0631\r\n                </b>\r\n            </td>\r\n            <td class=\"end\" style=\"padding: 5px 12px 12px 12px;\">\r\n                    {{doc.pos_profile}}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <hr>\r\n\r\n    <table dir=\"rtl\" class=\"bordered\">\r\n        <thead style=\"background-color: #f2f0f0\">\r\n            <tr>\r\n                <td class=\"start\"><strong>{{ _(\"\u0627\u0644\u0635\u0646\u0641\") }}</strong></td>\r\n                <td width=\"10%\" class=\"center\"><strong>{{ _(\"\u0643\u0645\u064a\u0629\") }}</strong></td>\r\n                <td width=\"10%\" class=\"center\"><strong>{{ _(\"\u0633\u0639\u0631\") }}</strong></td>\r\n                <td width=\"10%\" class=\"center\"><strong>{{ _(\"\u0627\u062c\u0645\u0627\u0644\u064a\") }}</strong></td>\r\n            </tr>\r\n        </thead>\r\n\r\n        <tbody>\r\n\r\n            {% set ns = namespace(total=0) %}\r\n\r\n            {% for item in group_items %}\r\n\r\n            {% set ns.total = ns.total + item.price_list_rate*item.qty %}\r\n\r\n            <tr>\r\n                <td class=\"start\">{{ item.item_name }}</td>\r\n\r\n                <td class=\"center white-space\">\r\n                    {{ \"{:,.0f}\".format(item.qty) if item.qty else \"-\" }}\r\n                </td>\r\n                <td class=\"end white-space\">\r\n                    {{ \"{:,.0f}\".format(item.price_list_rate) if item.price_list_rate else \"-\" }}\r\n                </td>\r\n\r\n                <td class=\"end white-space\">\r\n                    {{ \"{:,.0f}\".format(item.price_list_rate*item.qty) if item.price_list_rate else \"-\" }}\r\n                </td>\r\n            </tr>\r\n            {% if item.remarks %}\r\n            <tr>\r\n                <td colspan=\"4\" class=\"start\">#{{ item.remarks }}</td>\r\n            </tr>\r\n            {% endif %}\r\n\r\n            {% endfor %}\r\n\r\n        </tbody>\r\n\r\n        <tfoot>\r\n            <tr class=\"bold\">\r\n                <td style=\"background-color: #f2f0f0\">{{ _(\"Total\") }}</td>\r\n\r\n                <td class=\"end\" colspan=\"3\">\r\n                    {{ \"{:,.0f}\".format(ns.total) }}\r\n              